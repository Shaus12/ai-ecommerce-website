# ================================================================
#  AI Company — configuration
#  Fill in the empty values here, in this file.
#  Never paste these values into a chat.
# ================================================================

# ---- Company -------------------------------------------------------
# Brand name customers will see (store, emails, invoices)
COMPANY_NAME=
PRODUCT_NAME=AI voice recorder and meeting note-taker
TARGET_MARKET=US
CURRENCY=USD

# ---- Anthropic: the agents' brains ---------------------------------
# console.anthropic.com -> API Keys -> Create Key
# Also set a monthly spend limit of 250 USD there (Billing -> Limits)
ANTHROPIC_API_KEY=

# ---- SUMIT: payments and invoices ----------------------------------
# SUMIT -> Settings -> Developers / API
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
# SUMIT -> Payment pages: create an English page, currency USD,
# open price, then paste its link here
SUMIT_PAYMENT_PAGE_URL=

# ---- Dashboard -----------------------------------------------------
# Password for the control-room website. Required before it goes online.
DASHBOARD_PASSWORD=
PORT=8080

# ---- Safety rails --------------------------------------------------
# guarded = spending, publishing and supplier orders need your approval
AUTONOMY_MODE=guarded
LLM_BUDGET_USD=250
ADS_BUDGET_USD=0
APPROVAL_THRESHOLD_USD=25

# ---- Ads (later) ---------------------------------------------------
META_ADS_TOKEN=
TIKTOK_ADS_TOKEN=

# ---- Database: local, leave as is ----------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=aico
PGPASSWORD=change-me
PGDATABASE=aicompany

# ---- Scheduler -----------------------------------------------------
# true = agents stay paused on startup until you press "הפעל הכל"
SCHEDULER_START_PAUSED=true
